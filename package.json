{
  "name": "saha-platform",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @saha/web --filter @saha/api dev",
    "worker": "pnpm --filter @saha/api worker",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @saha/api test",
    "test:integration": "pnpm --filter @saha/api test:integration",
    "db:generate": "pnpm --filter @saha/api db:generate",
    "db:migrate": "pnpm --filter @saha/api db:migrate"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "eslint": "^9.28.0",
    "typescript-eslint": "^8.33.0",
    "@eslint/js": "^9.28.0"
  }
}
