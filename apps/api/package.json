{
  "name": "@saha/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/main.ts",
    "worker": "tsx src/queues/worker.ts",
    "worker:dev": "tsx watch src/queues/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit.test.ts test/phase2.unit.test.ts test/phase3.unit.test.ts",
    "test:integration": "vitest run test/integration.test.ts test/phase2.integration.test.ts test/phase2.queue.test.ts test/phase3.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "@saha/shared": "workspace:*",
    "bullmq": "5.58.5",
    "cheerio": "1.0.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "5.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "ioredis": "5.6.1",
    "ipaddr.js": "2.2.0",
    "reflect-metadata": "^0.2.2",
    "robots-parser": "3.0.1",
    "rxjs": "^7.8.2",
    "tsx": "^4.19.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.0",
    "supertest": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
