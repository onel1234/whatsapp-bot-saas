generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  OWNER
  AGENT
}
enum Plan {
  FREE
  STARTER
  GROWTH
  BUSINESS
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String?
  createdAt DateTime @default(now())
  sessions Session[]
  identities AuthIdentity[]
  memberships Membership[]
}
model AuthIdentity {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  provider String
  subject String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, subject])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Tenant {
  id String @id @default(uuid()) @db.Uuid
  name String
  plan Plan @default(FREE)
  createdAt DateTime @default(now())
  memberships Membership[]
  invitations Invitation[]
  products Product[]
  variants ProductVariant[]
  knowledgeSources KnowledgeSource[]
  knowledgeEntries KnowledgeEntry[]
  knowledgeChunks KnowledgeChunk[]
  crawlRuns CrawlRun[]
  tasks BackgroundTask[]
  botConfig BotConfig?
  conversations Conversation[]
  messages ChatMessage[]
  turns ConversationTurn[]
  notifications Notification[]
}

model BotConfig {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid
  publicId String @unique @default(uuid()) @db.Uuid
  settings Json
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, id])
}
model Conversation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tokenHash String @unique
  origin String
  preview Boolean @default(false)
  expiresAt DateTime
  mode String @default("BOT")
  language String @default("en")
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  turns ConversationTurn[]
  notifications Notification[]
  @@unique([tenantId, id])
}
model ChatMessage {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  conversationId String @db.Uuid
  clientMessageId String? @db.Uuid
  turnId String? @unique @db.Uuid
  sender String
  body String
  language String
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  turn ConversationTurn? @relation("Reply", fields: [tenantId, turnId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, turnId])
  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, clientMessageId])
  @@index([tenantId, conversationId, createdAt])
}
model ConversationTurn {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  conversationId String @db.Uuid
  clientMessageId String @db.Uuid
  text String
  status String @default("PENDING")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  reply ChatMessage? @relation("Reply")
  @@unique([tenantId, id])
  @@unique([tenantId, conversationId, clientMessageId])
  @@index([status, createdAt])
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  conversationId String @db.Uuid
  reason String
  readAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, id])
  @@unique([tenantId, conversationId])
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId String @db.Uuid
  role Role
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@unique([tenantId, id])
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  email String
  role Role @default(AGENT)
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, id])
}

enum ReviewStatus {
  DRAFT
  APPROVED
  CHANGES_PENDING
}
enum EmbeddingStatus {
  NONE
  PENDING
  READY
  FAILED
}
enum CrawlStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}
enum TaskKind {
  CRAWL
  EMBED
}
enum TaskStatus {
  PENDING
  DISPATCHED
  RUNNING
  SUCCEEDED
  FAILED
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  sku String
  nameEn String
  nameSi String @default("")
  nameTa String @default("")
  description String @default("")
  imageUrl String @default("")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  @@unique([tenantId, id])
  @@unique([tenantId, sku])
}
model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  productId String @db.Uuid
  sku String
  attributes Json @default("{}")
  priceMinor Int
  stock Int
  active Boolean @default(true)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, id])
  @@unique([tenantId, sku])
}
model KnowledgeSource {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  url String
  pageLimit Int @default(20)
  depthLimit Int @default(2)
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries KnowledgeEntry[]
  runs CrawlRun[]
  @@unique([tenantId, id])
  @@unique([tenantId, url])
}
model CrawlRun {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  knowledgeSourceId String @db.Uuid
  status CrawlStatus @default(QUEUED)
  pageCount Int @default(0)
  skippedCount Int @default(0)
  errorCode String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source KnowledgeSource @relation(fields: [tenantId, knowledgeSourceId], references: [tenantId, id], onDelete: Cascade)
  task BackgroundTask?
  @@unique([tenantId, id])
}
model KnowledgeEntry {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  knowledgeSourceId String? @db.Uuid
  sourceUrl String?
  sourceContentHash String?
  title String
  draftContent String
  approvedTitle String?
  approvedContent String?
  reviewStatus ReviewStatus @default(DRAFT)
  version Int @default(1)
  approvedRevision Int @default(0)
  embeddingStatus EmbeddingStatus @default(NONE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source KnowledgeSource? @relation(fields: [tenantId, knowledgeSourceId], references: [tenantId, id], onDelete: Cascade)
  chunks KnowledgeChunk[]
  tasks BackgroundTask[]
  @@unique([tenantId, id])
  @@unique([tenantId, knowledgeSourceId, sourceUrl])
}
model KnowledgeChunk {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  knowledgeEntryId String @db.Uuid
  revision Int
  ordinal Int
  content String
  embeddingModel String
  embeddingVersion String
  embedding Unsupported("vector(64)")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entry KnowledgeEntry @relation(fields: [tenantId, knowledgeEntryId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, id])
  @@unique([tenantId, knowledgeEntryId, revision, ordinal])
}
model BackgroundTask {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  kind TaskKind
  status TaskStatus @default(PENDING)
  crawlRunId String? @db.Uuid
  knowledgeEntryId String? @db.Uuid
  revision Int?
  attempts Int @default(0)
  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run CrawlRun? @relation(fields: [tenantId, crawlRunId], references: [tenantId, id], onDelete: Cascade)
  entry KnowledgeEntry? @relation(fields: [tenantId, knowledgeEntryId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, id])
  @@unique([tenantId, crawlRunId])
  @@unique([tenantId, knowledgeEntryId, revision])
  @@index([status, createdAt])
}
