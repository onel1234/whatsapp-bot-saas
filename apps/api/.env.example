DATABASE_URL=postgresql://saha_app:saha_dev_app@localhost:5432/saha?schema=public
DIRECT_URL=postgresql://postgres:saha_dev_admin@localhost:5432/saha?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
PORT=4000
# Local development provider; use queue mode with Redis and pnpm worker to test dispatch.
WIDGET_PROCESSING_MODE=inline
# Production startup refuses the development LLM unless explicitly enabled for a staging review.
ALLOW_DEVELOPMENT_LLM=false
# Optional; Google sign-in stays unavailable until all three are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Meta webhook app credentials; set secrets locally, never commit them.
META_APP_SECRET=
META_VERIFY_TOKEN=
# Server-reviewed routing registry: "CHANNEL:ACCOUNT_ID" -> workspace UUID.
# Prevents another workspace owner claiming someone else's account ID.
META_ACCOUNT_BINDINGS={}
# Select the supported Graph API version from your Meta app dashboard.
META_GRAPH_VERSION=
# Sending remains paused until explicitly enabled for approved test/live usage.
META_LIVE_SEND_ENABLED=false
# JSON map of version -> 32-byte hex key. Generate with crypto.randomBytes(32).
CHANNEL_ENCRYPTION_KEYS={}
CHANNEL_ENCRYPTION_KEY_VERSION=v1
